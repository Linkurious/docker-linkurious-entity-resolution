{{/*
Expand the name of the chart.
*/}}
{{- define "linkurious-entity-resolution.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Create a default fully qualified app name.
We truncate at 63 chars because some Kubernetes name fields are limited to this (by the DNS naming spec).
If release name contains chart name it will be used as a full name.
*/}}
{{- define "linkurious-entity-resolution.fullname" -}}
{{- if .Values.fullnameOverride }}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default .Chart.Name .Values.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{/*
Create chart name and version as used by the chart label.
*/}}
{{- define "linkurious-entity-resolution.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Common labels
*/}}
{{- define "linkurious-entity-resolution.labels" -}}
helm.sh/chart: {{ include "linkurious-entity-resolution.chart" . }}
{{ include "linkurious-entity-resolution.selectorLabels" . }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end }}

{{/*
Selector labels
*/}}
{{- define "linkurious-entity-resolution.selectorLabels" -}}
app.kubernetes.io/name: {{ include "linkurious-entity-resolution.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{/*
Name of the MariaDB run by the mariadb-operator (MariaDB resource, StatefulSet and Service).
It differs from the Bitnami one ("<fullname>-mariadb") so that both can run side by side during the migration.
The fullname is truncated to 41 characters, so that the name is at most 52 characters (41 + 11): the StatefulSet
created by the operator gets this name, and Kubernetes adds the label controller-revision-hash "<name>-<hash up to
10 chars>" to its pods, which must fit in 63 characters. The other names derived by the operator then fit too:
Service "<name>-internal" (61), "<name>-secondary" (62) and, with metrics, "<name>-metrics" (60), also used as the
instance label of the exporter selectors.
*/}}
{{- define "linkurious-entity-resolution.mariadbOperator.fullname" -}}
{{- printf "%s-mariadb-op" (include "linkurious-entity-resolution.fullname" . | trunc 41 | trimSuffix "-") }}
{{- end }}

{{/*
Selector labels of the mariadb-operator MariaDB pods (the operator sets app.kubernetes.io/name=mariadb and
app.kubernetes.io/instance=<MariaDB name> on them, they are also set explicitly through podMetadata).
*/}}
{{- define "linkurious-entity-resolution.selectorLabelsMariadbOperator" -}}
app.kubernetes.io/name: mariadb
app.kubernetes.io/instance: {{ include "linkurious-entity-resolution.mariadbOperator.fullname" . }}
{{- end }}

{{/*
Selector labels of the mysqld-exporter pods the operator deploys when mariadbOperator.metrics.enabled is true
(Deployment "<MariaDB name>-metrics", see WithMetricsSelectorLabels in the mariadb-operator)
*/}}
{{- define "linkurious-entity-resolution.selectorLabelsMariadbOperatorMetrics" -}}
app.kubernetes.io/name: exporter
app.kubernetes.io/instance: {{ include "linkurious-entity-resolution.mariadbOperator.fullname" . }}-metrics
{{- end }}

{{/*
Common labels of the mariadb-operator resources
*/}}
{{- define "linkurious-entity-resolution.labelsMariadbOperator" -}}
helm.sh/chart: {{ include "linkurious-entity-resolution.chart" . }}
{{ include "linkurious-entity-resolution.selectorLabelsMariadbOperator" . }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end }}

{{/*
Secret holding the passwords of the Bitnami MariaDB: mariadb.auth.existingSecret, or the one generated by the
Bitnami chart ("<fullname>-mariadb")
*/}}
{{- define "linkurious-entity-resolution.mariadb.secretName" -}}
{{- with .Values.mariadb.auth.existingSecret -}}
{{- tpl . $ -}}
{{- else -}}
{{- printf "%s-mariadb" (include "linkurious-entity-resolution.fullname" .) -}}
{{- end -}}
{{- end }}

{{/*
Secret holding the passwords of the mariadb-operator MariaDB (keys mariadb-root-password and mariadb-password):
mariadbOperator.auth.existingSecret, else mariadb.auth.existingSecret (the same secret as the Bitnami database).
Never the secret generated by the Bitnami chart: it is deleted with it (mariadb.enabled: false), and the new database
would lose its credentials.
*/}}
{{- define "linkurious-entity-resolution.mariadbOperator.secretName" -}}
{{- with .Values.mariadbOperator.auth.existingSecret -}}
{{- tpl . $ -}}
{{- else -}}
{{- with .Values.mariadb.auth.existingSecret -}}
{{- tpl . $ -}}
{{- else -}}
{{- fail "mariadbOperator.auth.existingSecret or mariadb.auth.existingSecret is required: the secret generated by the Bitnami chart is deleted with it" -}}
{{- end -}}
{{- end -}}
{{- end }}

{{/*
"true" when linkurious-entity-resolution uses the mariadb-operator MariaDB instead of the Bitnami one
*/}}
{{- define "linkurious-entity-resolution.mariadbOperator.primary" -}}
{{- if .Values.mariadbOperator.primary -}}
{{- if not .Values.mariadbOperator.enabled -}}
{{- fail "mariadbOperator.primary requires mariadbOperator.enabled" -}}
{{- end -}}
true
{{- end -}}
{{- end }}

{{/*
Create the name of the service account to use
*/}}
{{- define "linkurious-entity-resolution.serviceAccountName" -}}
{{- if .Values.serviceAccount.create }}
{{- default (include "linkurious-entity-resolution.fullname" .) .Values.serviceAccount.name }}
{{- else }}
{{- default "default" .Values.serviceAccount.name }}
{{- end }}
{{- end }}
{{/*
Default external url
*/}}
{{- define "linkurious-entity-resolution.defaultHostUrl" -}}
{{- print   (include "linkurious-entity-resolution.fullname" .) "."  .Release.Namespace "." .Values.hostPostfix  -}}
{{- end }}
